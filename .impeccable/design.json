  "narrative": {
    "northStar": "The Programming Sheet",
    "overview": "Ledger looks like a ruled, chalked programming sheet in a plate-loaded gym. It is an operating tool, so structure does the work: a strict grid, clear hairlines, outlined controls and numbers that line up. Depth comes from five separable surface steps and two line weights, not shadows.",
    "keyCharacteristics": [
      "Five-step tonal ladder with a hairline and an outline",
      "Roboto throughout, tabular numerals for load data",
      "Plate colours carry meaning",
      "Muscle colour is a 9px swatch",
      "Dark by default, cool-neutral light theme"
    ],
    "rules": [
      {
        "name": "The Plate Colour Rule",
        "body": "Red, yellow and green mean load state and nothing else.",
        "section": "colors"
      },
      {
        "name": "The One Accent Rule",
        "body": "Plate blue is the only accent.",
        "section": "colors"
      },
      {
        "name": "The Swatch Rule",
        "body": "A muscle colour is a 9px square beside a name, never a border or tinted card.",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every number a lifter compares is tabular and never truncated.",
        "section": "typography"
      },
      {
        "name": "The No Nested Card Rule",
        "body": "Panels never contain panels.",
        "section": "layout"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Surfaces carry no shadow at rest.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do separate layers with the tonal ladder and the two line weights; every control gets the outline weight.",
      "Do use plate blue for the single next action and plate colours only for load state.",
      "Do show muscle identity as a 9px swatch next to the name.",
      "Do keep all load numbers tabular and fully visible, wrapping names rather than truncating numbers.",
      "Do scroll wide tables inside their own frame.",
      "Do respect reduced motion; the sheet rise is the one motion moment."
    ],
    "donts": [
      "Don't put cards inside cards.",
      "Don't add eyebrow labels above headings.",
      "Don't use coloured side bars or tinted card backgrounds for muscle groups.",
      "Don't add resting shadows, gradients or glow.",
      "Don't introduce a second accent colour or use red, yellow or green decoratively.",
      "Don't use cream or warm beige in the light theme."
    ]
  }
