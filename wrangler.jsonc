{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ledger",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "ledger", "database_id": "ded315e4-d370-45b5-8ba9-27c2453a7463" }],
  "routes": [{ "pattern": "ledger.coachleonidas.com", "custom_domain": true }]
}
